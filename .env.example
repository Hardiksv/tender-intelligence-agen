# ==============================================================================
# Environment Configuration Template for Tender Intelligence Agent
# Copy this file to .env and configure your credentials:
# cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL with pgvector)
# (In-memory/local SQLite store is automatically used as zero-config fallback if PostgreSQL is unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tender_db
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/tender_test

# Primary LLM Configuration (LiteLLM Gateway)
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini/gemini-2.5-pro

# Embedding Model Configuration (Gemini text-embedding-004 / Open Source)
EMBEDDING_MODEL=gemini/text-embedding-004
EMBEDDING_DIMENSION=768

# General Application Settings
TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Feature Flags & Automated Discovery Scheduler
INGESTION_ENABLED=true
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=60
