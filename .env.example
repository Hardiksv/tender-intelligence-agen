# Environment Configuration for Tender Intelligence Agent

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tender_db
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/tender_test

# LLM Configuration (LiteLLM)
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini/gemini-2.5-pro

# Embeddings Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# General Application Settings
TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Feature & Scheduler Flags
INGESTION_ENABLED=true
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=60
