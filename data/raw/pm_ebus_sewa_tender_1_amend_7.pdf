					<style>
/* === PREVENT LAYOUT SHIFT === */
.gov-utility-bar {
  min-height: 38px;
  visibility: hidden;
}
.gov-utility-bar.loaded {
  visibility: visible;
}

/* === BAR STYLES === */
.gov-utility-bar {
  display: flex; justify-content: space-between; align-items: center;
  background: #2b2b2b; color: #fff; padding: 6px 10px; font-size: 12px;
  position: relative; z-index: 999; flex-wrap: wrap; box-sizing: border-box;
}
.gov-brand { display: flex; align-items: center; gap: 6px; }
.gov-brand img { height: 18px; width: auto; }
.gov-brand span { font-weight: 600; font-size: 13px; white-space: nowrap; }

.gov-links { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.gov-links a, .gov-links button {
  color: #fff; background: none; border: none; padding: 4px 6px; font-size: 12px;
  border-radius: 3px; cursor: pointer; text-decoration: none;
}
.gov-links a:hover, .gov-links button:hover { background: #444; }

.text-size-group {
  display: flex; background: #424242; border-radius: 3px; overflow: hidden;
}
.text-size-group button {
  padding: 4px 6px; border: none; background: none; color: #fff; font-size: 12px;
  border-left: 1px solid #5a5a5a; cursor: pointer;
}
.text-size-group button:first-child { border-left: none; }
.text-size-group button.active { background: #1a1a1a; }

.hamburger { display: none; font-size: 20px; background: none; border: none; color: #fff; cursor: pointer; }

.mobile-menu {
  display: none; flex-direction: column; background: #333; padding: 8px 10px;
  position: absolute; right: 0; top: 100%; width: 100%; box-shadow: 0 4px 8px rgba(0,0,0,0.4); z-index: 999;
}
.mobile-menu.show { display: flex; }

@media (max-width: 700px) {
  .gov-links { display: none; }
  .hamburger { display: block; }
  .gov-brand img { height: 20px; }
  .gov-brand span { font-size: 14px; }
}

body.font-large { font-size: 110% !important; }
body.font-xlarge { font-size: 125% !important; }
body.high-contrast, body.high-contrast * { background: black !important; color: yellow !important; }

/* === BHASHINI ICON = BRIGHT GREEN === */
.bhashini-plugin-container img,
.bhashini-plugin-container svg,
.bhashini-plugin-container .bhashini-icon {
  filter: brightness(0) invert(39%) sepia(99%) saturate(1000%) hue-rotate(90deg) brightness(100%) contrast(110%) !important;
  width: 26px !important;
  height: 26px !important;
  background: transparent !important;
}
</style>

