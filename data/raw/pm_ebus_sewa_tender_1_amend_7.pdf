					<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buses Card – Clean & Clickable</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap" rel="stylesheet">
    <style>
        .card-link {
            display: block;
            width: 213px;
            height: 300px;
            text-decoration: none;
            border-radius: 25px;
            overflow: hidden;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
            font-family: 'Montserrat', sans-serif;
        }

        @media (min-width: 769px) {
            .card-link:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
            }
        }

        @media (max-width: 768px) {
            .card-link:hover {
                transform: none;
                box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
            }
        }

        .card-link:focus-visible {
            outline: 3px solid #8fbce6;
            outline-offset: 5px;
        }

        .card-bg {
            width: 100%;
            height: 100%;
            background: #5085A5;
            border-radius: 25px;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .card-image-area {
            width: 201px;
            height: 200px;
            background: white;
            border-radius: 25px;
            position: absolute;
            left: 6px;
            top: 7px;
            box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2;
        }

        .card-image {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        .card-stats {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            color: white;
            font-weight: bold;
            font-size: 19px;
            line-height: 1.4;
            z-index: 3;
            width: 85%;
        }
    </style>
</head>
<body>

<a href="?page_id=3407"
   class="card-link"
   target="_blank"
   aria-label="Buses 9360, Cities 106, States 19">

    <div class="card-bg"></div>

    <div class="card-image-area">
        <img decoding="async" class="card-image"
             src="wp-content/uploads/2025/07/Untitled-design-20-3.png"
             alt="Electric bus">
    </div>

    <div class="card-stats">
        Buses 10,000<br>
        Cities 116<br>
        State/Uts 26
    </div>
</a>

</body>
</html>				</div>
