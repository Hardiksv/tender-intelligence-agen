				<div class="elementor-element elementor-element-fb48b9d e-con-full e-flex e-con e-parent" data-id="fb48b9d" data-element_type="container">
				<div class="elementor-element elementor-element-2a3d0c8 elementor-widget elementor-widget-shortcode" data-id="2a3d0c8" data-element_type="widget" data-widget_type="shortcode.default">
							<div class="elementor-shortcode"><style>
/* ---------- FOOTER BASE STYLES ---------- */
footer {
    font-family: 'Roboto', sans-serif;
    background: #f1f5f9;
    border-top: 1px solid #ccc;
    color: #4b5563;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    box-sizing: border-box;
    position: relative;
    bottom: 0;
    overflow: hidden;
}
/* ADDED STYLE FOR VISITOR COUNT */
.visitor-count {
    font-size: 16px;
    color: #35629f; /* Using the primary blue color for emphasis */
    font-weight: bold;
    margin-top: 10px; /* Space below the logos */
    padding-top: 5px;
    /* Dotted line removed */
}
.visitor-count span {
    color: #4b5563; /* Use the default footer text color for the labels */
}

/* Original styles continue... */
.footer-col:nth-child(2) i.fa-arrow-right {
    display: none !important;
}
.footer-bg-image {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 440px;
    margin-top: -80px;
    background-image: url('/wp-content/uploads/2025/10/Screenshot-2025-10-22-180751.png');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: right center;
    opacity: 0.4;
    pointer-events: none;
    z-index: 0;
}
.footer-wrapper {
    max-width: 1380px;
    margin: 0 auto;
    padding: 20px 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 60px;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
}
.footer-col {
    flex: 1 1 100%;
    min-width: 280px;
}
.footer-col:nth-child(2) {
    margin-left: -250px;
}
@media (min-width: 768px) {
    .footer-col {
        flex: 1 1 calc(50% - 40px);
    }
}
.footer-col h3 {
    font-size: 33px;
    color: #35629f;
    margin-bottom: 25px;
}
.footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
}
.footer-col li {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 1px;
}
.footer-col li a {
    text-decoration: none;
    color: #4b5563;
    transition: color 0.3s ease;
}
.footer-col li a:hover {
    color: #35629f;
    text-decoration: underline;
}
.last-updated {
    font-size: 15px;
    color: #4b5563;
    margin: 15px 0 5px 10px;
    margin-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.last-updated-text {
    display: flex;
    align-items: center;
    gap: 5px;
}
.footer-images {
    display: flex;
    gap: 15px;
    align-items: center;
    flex-wrap: wrap; /* Added for better mobile support */
}
.footer-images img {
    height: 50px;
    width: auto;
    object-fit: contain;
    margin-top: 16px;
}
.footer-bottom {
    background: #35629F;
    color: white;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: 12px 15px;
    text-align: center;
    font-size: 15px;
    box-sizing: border-box;
    white-space: normal;
    line-height: 1.5;
}

/* ---------- MOBILE RESPONSIVE (SHOW USEFUL LINKS) ---------- */
@media (max-width: 767px) {
    /* Hide background image on mobile */
    .footer-bg-image {
        display: none;
    }

    /* Show Useful Links on mobile (stacked below Contact) */
    .footer-col:nth-child(2) {
        display: block !important;
        margin-left: 0 !important;
        margin-top: 20px;
    }

    /* Reset margins & center content */
    .footer-col > div {
        margin-left: 0 !important;
    }

    .footer-wrapper {
        gap: 30px;
        padding: 25px 15px;
        flex-direction: column;
        align-items: center;
    }

    .footer-col {
        flex: 1 1 100%;
        min-width: auto;
        text-align: left;
    }

    .footer-col h3 {
        font-size: 26px;
        text-align: center;
    }

    .footer-col ul {
        text-align: left;
    }

    .footer-bottom {
        white-space: normal;
        padding: 15px;
        font-size: 14px;
    }
    .visitor-count {
        text-align: center;
        width: 100%;
        margin-top: 15px;
    }
}

/* Prevent horizontal scroll */
html, body {
    overflow-x: hidden;
}
</style>

<footer>
    <div class="footer-bg-image"></div>

    <div class="footer-wrapper">
        <div class="footer-col">
            <div style="margin-left: 15px;">
