    <button>Screen Reader</button>
    <button id="hc-toggle" class="high-contrast-button">HC</button>
    <div class="text-size-group">
      <button data-size="normal" class="active">A</button>
      <button data-size="large">A+</button>
      <button data-size="xlarge">A++</button>
    </div>
    <span id="live-clock"></span>
    <div class="bhashini-plugin-container"></div>
  </div>

  <div class="mobile-menu" id="gov-mobile-menu">
    <a href="#main">Skip to Main Content</a>
    <button>Screen Reader</button>
    <button id="hc-toggle-mobile">HC</button>
    <div class="text-size-group">
      <button data-size="normal" class="active">A</button>
      <button data-size="large">A+</button>
      <button data-size="xlarge">A++</button>
    </div>
    <div class="bhashini-plugin-container"></div>
  </div>
</div>

<script>
const bhashiniScript = document.createElement('script');
bhashiniScript.src = 'https://translation-plugin.bhashini.co.in/v3/website_translation_utility.js';
bhashiniScript.onload = () => setTimeout(() => document.getElementById('gov-utility-bar')?.classList.add('loaded'), 100);
document.head.appendChild(bhashiniScript);
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const toggle = document.getElementById('gov-menu-toggle');
  const menu = document.getElementById('gov-mobile-menu');
  if (toggle && menu) toggle.onclick = () => menu.classList.toggle('show');

  document.querySelectorAll('[data-size]').forEach(btn => {
    btn.onclick = function () {
      document.body.className = document.body.className.replace(/font-\w+/g, '');
      if (this.dataset.size !== 'normal') document.body.classList.add('font-' + this.dataset.size);
      document.querySelectorAll('[data-size]').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
    };
  });

  document.querySelectorAll('#hc-toggle, #hc-toggle-mobile').forEach(btn => {
    btn.onclick = () => document.body.classList.toggle('high-contrast');
  });

  function updateClock() {
    const now = new Date();
    const clock = document.getElementById('live-clock');
    if (clock) clock.textContent = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
  }
  updateClock();
  setInterval(updateClock, 1000);

  setTimeout(() => document.getElementById('gov-utility-bar')?.classList.add('loaded'), 1000);
});
</script>				</div>
				</div>
