		<div class="elementor-element elementor-element-3679a00 e-con-full elementor-hidden-mobile elementor-hidden-desktop e-flex e-con e-parent" data-id="3679a00" data-element_type="container">
		<div class="elementor-element elementor-element-0dcd9f4 e-con-full e-flex e-con e-child" data-id="0dcd9f4" data-element_type="container">
				<div class="elementor-element elementor-element-9d4a954 elementor-widget elementor-widget-heading" data-id="9d4a954" data-element_type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">PM-eBus Sewa Sanction Status</h2>				</div>
		<div class="elementor-element elementor-element-fd27c2d e-con-full e-flex e-con e-child" data-id="fd27c2d" data-element_type="container">
		<div class="elementor-element elementor-element-dfa54f7 e-grid e-con-boxed e-con e-child" data-id="dfa54f7" data-element_type="container">
					<div class="e-con-inner">
				<div class="elementor-element elementor-element-df37e9f elementor-widget elementor-widget-html" data-id="df37e9f" data-element_type="widget" data-widget_type="html.default">
					<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clickable Card</title>
    <style>
        /* Card Container Styles */
        .card-link {
            text-decoration: none; /* Removes underline from the link */
            display: inline-block; /* Allows the link to wrap the card */
            cursor: pointer;
        }

        .card-container {
            width: 213px;
            height: 300px;
            position: relative;
            /* Remove extra white spacing caused by transition on the inner elements */
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-sizing: border-box; /* Includes padding and border in the element's total width and height */
        }

        /* Hover Effect for Desktop/Larger Screens */
        @media (min-width: 769px) {
            .card-container:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
            }
        }

        /* Card Inner Content */
        .card-inner {
            width: 100%; /* Inherit from container */
            height: 100%; /* Inherit from container */
            position: relative;
        }

        /* Background Rectangle (Z-index 1) */
        .card-background {
            width: 100%;
            height: 100%;
            position: absolute;
            left: 0;
            top: 0;
            background: #5085A5;
            box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
            border-radius: 25px;
            z-index: 1;
        }

        /* White Image Area (Z-index 2) */
        .card-image-area {
            width: 201px;
            height: 200px;
            position: absolute;
            left: 6px;
            top: 7px;
            background: white;
            box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
            border-radius: 25px;
            z-index: 2;
            overflow: hidden; /* To keep the image within the border-radius */
        }

        /* Image (Z-index 3) */
        .card-image {
            /* Adjusted size and position for better centering and fit */
            width: 172.91px;
            height: 179px;
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
        }

